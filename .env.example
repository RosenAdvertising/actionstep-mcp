# Actionstep MCP — environment variables
# Copy to ~/.actionstep-mcp/.env and fill in your values.
# oauth_flow.py writes this file automatically during setup.

ACTIONSTEP_CLIENT_ID=your_client_id_here
ACTIONSTEP_CLIENT_SECRET=your_client_secret_here
# Use the vendor-issued regional, per-organization, or staging endpoint.
ACTIONSTEP_API_ENDPOINT=https://ap-southeast-2.actionstep.com
# Destination tools refuse requests until the administrator approves hosts.
ACTIONSTEP_ALLOWED_DESTINATION_HOSTS=
