# Actionstep MCP — environment variables
# Copy to ~/.actionstep-mcp/.env and fill in your values.
# oauth_flow.py writes this file automatically during setup.

ACTIONSTEP_CLIENT_ID=your_client_id_here
ACTIONSTEP_CLIENT_SECRET=your_client_secret_here
ACTIONSTEP_API_ENDPOINT=https://your-org.actionstep.com
